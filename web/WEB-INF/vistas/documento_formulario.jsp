<%-- Autor: Rodriguez Alvarado Andersson Eduardo --%>
<%@page pageEncoding="UTF-8"%>
<%@include file="cabecera.jspf"%><%@include file="ventas_nav.jspf"%>
<h1 class="mb-4"><c:choose><c:when test="${esGuia}">Guía de remisión</c:when><c:otherwise>Factura o boleta</c:otherwise></c:choose></h1><div class="card"><div class="card-body p-4"><form method="post" action="${pageContext.request.contextPath}${ruta}"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="accion" value="guardar">
<c:choose><c:when test="${esGuia}"><input type="hidden" name="id" value="${registro.idGuia == 0 ? '' : registro.idGuia}"></c:when><c:otherwise><input type="hidden" name="id" value="${registro.idComprobante == 0 ? '' : registro.idComprobante}"></c:otherwise></c:choose>
<label class="form-label" for="idVenta">Venta</label><select class="form-select mb-3" name="idVenta" id="idVenta" required><option value="">Selecciona una venta emitida</option><c:forEach var="v" items="${ventas}"><c:if test="${v.estado == 'EMITIDA' || v.idVenta == registro.idVenta}"><option value="${v.idVenta}" ${v.idVenta == registro.idVenta ? 'selected' : ''}><c:out value="${v.nroVenta}"/> · <c:out value="${v.cliente}"/> · S/ <c:out value="${v.total}"/></option></c:if></c:forEach></select>
<c:choose><c:when test="${esGuia}"><div class="row g-3"><div class="col-md-6"><label class="form-label" for="fechaTraslado">Fecha de traslado</label><input class="form-control" type="date" min="1900-01-01" max="9999-12-31" id="fechaTraslado" name="fechaTraslado" required value="<c:out value='${registro.fechaTraslado}'/>"></div>
<div class="col-md-6"><label class="form-label" for="estado">Estado</label><select class="form-select" id="estado" name="estado"><option ${registro.estado == 'PENDIENTE' ? 'selected' : ''}>PENDIENTE</option><option ${registro.estado == 'ENTREGADA' ? 'selected' : ''}>ENTREGADA</option><option ${registro.estado == 'ANULADA' ? 'selected' : ''}>ANULADA</option></select></div>
<div class="col-md-6"><label class="form-label" for="puntoPartida">Punto de partida</label><input class="form-control" id="puntoPartida" name="puntoPartida" maxlength="200" required value="<c:out value='${registro.puntoPartida}'/>"></div><div class="col-md-6"><label class="form-label" for="puntoLlegada">Punto de llegada</label><input class="form-control" id="puntoLlegada" name="puntoLlegada" maxlength="200" required value="<c:out value='${registro.puntoLlegada}'/>"></div></div><p class="text-muted mt-3">Requiere un comprobante previo. Serie T001 y número automáticos.</p></c:when>
<c:otherwise><label class="form-label" for="tipo">Tipo</label><select class="form-select" id="tipo" name="tipo"><option value="BOLETA" ${registro.tipo == 'BOLETA' ? 'selected' : ''}>BOLETA · B001</option><option value="FACTURA" ${registro.tipo == 'FACTURA' ? 'selected' : ''}>FACTURA · F001</option></select><p class="text-muted mt-3">La factura exige RUC de 11 dígitos. El número y el total se calculan automáticamente. No se cambia la venta de un documento existente.</p></c:otherwise></c:choose>
<div class="mt-4"><button class="btn btn-primary">Guardar</button> <a class="btn btn-outline-secondary" href="${pageContext.request.contextPath}${ruta}">Cancelar</a></div></form></div></div><%@include file="pie.jspf"%>
