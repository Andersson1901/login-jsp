<%-- Autor: Rodriguez Alvarado Andersson Eduardo --%>
<%@page pageEncoding="UTF-8"%>
<%@include file="cabecera.jspf"%><%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="mb-0">Reporte de ventas</h1><p class="text-muted mb-0"><c:choose><c:when test="${not empty reporte}"><c:out value="${empty reporte.vendedor ? 'Toda la tienda' : reporte.vendedor}"/></c:when><c:otherwise>Pedidos y ventas por rango de fechas</c:otherwise></c:choose></p></div></div>
<form method="get" action="reportes" class="card mb-4"><div class="card-body row g-3 align-items-end">
<c:if test="${sessionScope.rol != 'VENDEDOR'}"><div class="col-md-4"><label class="form-label" for="vendedor">Vendedor</label><select class="form-select" id="vendedor" name="vendedor"><option value="">Toda la tienda</option><c:forEach var="u" items="${vendedores}"><option value="${u.idUsuario}"${u.idUsuario == vendedor ? ' selected' : ''}><c:out value="${u.nombres} ${u.apellidos} (${u.usuario})"/></option></c:forEach></select></div></c:if>
<div class="col-md-3"><label class="form-label" for="desde">Desde</label><input class="form-control" type="date" id="desde" name="desde" value="<c:out value='${desde}'/>" required></div>
<div class="col-md-3"><label class="form-label" for="hasta">Hasta</label><input class="form-control" type="date" id="hasta" name="hasta" value="<c:out value='${hasta}'/>" required></div>
<div class="col-md-2 acciones"><button class="btn btn-primary">Ver reporte</button><c:if test="${not empty reporte}"><button class="btn btn-dorado" name="formato" value="xlsx">Descargar Excel</button></c:if></div>
</div></form>
<c:if test="${not empty reporte}">
<div class="row g-3 mb-4">
<div class="col-sm-6 col-xl-3"><div class="card resumen h-100"><div class="card-body"><p>Pedidos (SOLPED)</p><strong class="display-6"><c:out value="${reporte.totalPedidos}"/></strong></div></div></div>
<div class="col-sm-6 col-xl-3"><div class="card resumen h-100"><div class="card-body"><p>Ventas emitidas</p><strong class="display-6"><c:out value="${reporte.ventasEmitidas}"/></strong></div></div></div>
<div class="col-sm-6 col-xl-3"><div class="card resumen h-100"><div class="card-body"><p>Ingresos</p><strong class="display-6">S/ <fmt:formatNumber value="${reporte.ingresos}" pattern="#,##0.00"/></strong></div></div></div>
<div class="col-sm-6 col-xl-3"><div class="card resumen h-100"><div class="card-body"><p>Ticket promedio</p><strong class="display-6">S/ <fmt:formatNumber value="${reporte.ticketPromedio}" pattern="#,##0.00"/></strong></div></div></div>
</div>
<div class="row g-3 mb-4">
<div class="col-lg-5"><div class="card h-100"><div class="card-body"><h2 class="h5">Pedidos por estado</h2><div class="grafico" data-tabla="tPedidos" data-tipo="pie"></div>
<table class="table table-sm mt-3" id="tPedidos"><thead><tr><th>Estado</th><th>Pedidos</th></tr></thead><tbody><c:forEach var="e" items="${reporte.pedidosPorEstado}"><tr data-dato><td><c:out value="${e.key}"/></td><td data-valor="<c:out value='${e.value}'/>"><c:out value="${e.value}"/></td></tr></c:forEach></tbody></table></div></div></div>
<div class="col-lg-7"><div class="card h-100"><div class="card-body"><h2 class="h5">Ventas emitidas por día (S/)</h2><div class="grafico" data-tabla="tDias" data-tipo="line" data-columna="2" data-nombre="Importe"></div>
<table class="table table-sm mt-3" id="tDias"><thead><tr><th>Fecha</th><th>Ventas</th><th>Importe</th></tr></thead><tbody><c:forEach var="p" items="${reporte.porDia}"><tr data-dato><td><c:out value="${p.etiqueta}"/></td><td data-valor="<c:out value='${p.cantidad}'/>"><c:out value="${p.cantidad}"/></td><td data-valor="<c:out value='${p.importe}'/>">S/ <fmt:formatNumber value="${p.importe}" pattern="#,##0.00"/></td></tr></c:forEach><c:if test="${empty reporte.porDia}"><tr><td colspan="3" class="tabla-vacia">No hay ventas emitidas en el rango.</td></tr></c:if></tbody></table></div></div></div>
</div>
<div class="row g-3 mb-4">
<div class="col-lg-6"><div class="card h-100"><div class="card-body"><h2 class="h5">Productos más vendidos (top 10)</h2><div class="grafico" data-tabla="tProductos" data-tipo="bar" data-nombre="Unidades"></div>
<table class="table table-sm mt-3" id="tProductos"><thead><tr><th>Producto</th><th>Unidades</th><th>Importe</th></tr></thead><tbody><c:forEach var="p" items="${reporte.productos}"><tr data-dato><td><c:out value="${p.etiqueta}"/></td><td data-valor="<c:out value='${p.cantidad}'/>"><fmt:formatNumber value="${p.cantidad}" maxFractionDigits="3"/></td><td data-valor="<c:out value='${p.importe}'/>">S/ <fmt:formatNumber value="${p.importe}" pattern="#,##0.00"/></td></tr></c:forEach><c:if test="${empty reporte.productos}"><tr><td colspan="3" class="tabla-vacia">No hay ventas emitidas en el rango.</td></tr></c:if></tbody></table></div></div></div>
<div class="col-lg-6"><div class="card h-100"><div class="card-body"><h2 class="h5">Mejores clientes (top 10)</h2><div class="grafico" data-tabla="tClientes" data-tipo="bar" data-columna="2" data-nombre="Importe"></div>
<table class="table table-sm mt-3" id="tClientes"><thead><tr><th>Cliente</th><th>Compras</th><th>Importe</th></tr></thead><tbody><c:forEach var="p" items="${reporte.clientes}"><tr data-dato><td><c:out value="${p.etiqueta}"/></td><td data-valor="<c:out value='${p.cantidad}'/>"><c:out value="${p.cantidad}"/></td><td data-valor="<c:out value='${p.importe}'/>">S/ <fmt:formatNumber value="${p.importe}" pattern="#,##0.00"/></td></tr></c:forEach><c:if test="${empty reporte.clientes}"><tr><td colspan="3" class="tabla-vacia">No hay ventas emitidas en el rango.</td></tr></c:if></tbody></table></div></div></div>
</div>
<div class="card mb-4"><div class="card-body"><h2 class="h5">Detalle de ventas</h2>
<t:limite base="reportes" prefijo="v_"/>
<div class="table-responsive"><table class="table table-sm"><thead><tr><t:ordenable base="reportes" prefijo="v_" columna="nro" titulo="N° venta"/><t:ordenable base="reportes" prefijo="v_" columna="fecha" titulo="Fecha"/><t:ordenable base="reportes" prefijo="v_" columna="cliente" titulo="Cliente"/><t:ordenable base="reportes" prefijo="v_" columna="vendedor" titulo="Vendedor"/><t:ordenable base="reportes" prefijo="v_" columna="estado" titulo="Estado"/><t:ordenable base="reportes" prefijo="v_" columna="subtotal" titulo="Subtotal"/><t:ordenable base="reportes" prefijo="v_" columna="igv" titulo="IGV"/><t:ordenable base="reportes" prefijo="v_" columna="total" titulo="Total"/></tr></thead><tbody><c:forEach var="r" items="${ventasPagina.filas}"><tr><td><c:out value="${r[0]}"/></td><td><c:out value="${fn:substring(r[1],0,16)}"/></td><td><c:out value="${r[2]}"/></td><td><c:out value="${r[3]}"/></td><td><c:out value="${r[4]}"/></td><td>S/ <fmt:formatNumber value="${r[5]}" pattern="#,##0.00"/></td><td>S/ <fmt:formatNumber value="${r[6]}" pattern="#,##0.00"/></td><td>S/ <fmt:formatNumber value="${r[7]}" pattern="#,##0.00"/></td></tr></c:forEach><c:if test="${empty ventasPagina.filas}"><tr><td colspan="8" class="tabla-vacia">No hay ventas en el rango.</td></tr></c:if></tbody></table></div>
<t:paginador pagina="${ventasPagina}" base="reportes" prefijo="v_"/></div></div>
<div class="card mb-4"><div class="card-body"><h2 class="h5">Detalle de pedidos</h2>
<t:limite base="reportes" prefijo="p_"/>
<div class="table-responsive"><table class="table table-sm"><thead><tr><t:ordenable base="reportes" prefijo="p_" columna="nro" titulo="N° SOLPED"/><t:ordenable base="reportes" prefijo="p_" columna="fecha" titulo="Fecha"/><t:ordenable base="reportes" prefijo="p_" columna="cliente" titulo="Cliente"/><t:ordenable base="reportes" prefijo="p_" columna="vendedor" titulo="Vendedor"/><t:ordenable base="reportes" prefijo="p_" columna="estado" titulo="Estado"/><t:ordenable base="reportes" prefijo="p_" columna="subtotal" titulo="Subtotal"/></tr></thead><tbody><c:forEach var="r" items="${pedidosPagina.filas}"><tr><td><c:out value="${r[0]}"/></td><td><c:out value="${fn:substring(r[1],0,16)}"/></td><td><c:out value="${r[2]}"/></td><td><c:out value="${r[3]}"/></td><td><c:out value="${r[4]}"/></td><td>S/ <fmt:formatNumber value="${r[5]}" pattern="#,##0.00"/></td></tr></c:forEach><c:if test="${empty pedidosPagina.filas}"><tr><td colspan="6" class="tabla-vacia">No hay pedidos en el rango.</td></tr></c:if></tbody></table></div>
<t:paginador pagina="${pedidosPagina}" base="reportes" prefijo="p_"/></div></div>
<p class="text-muted">Ventas anuladas en el rango: <c:out value="${reporte.ventasAnuladas}"/> (S/ <fmt:formatNumber value="${reporte.montoAnulado}" pattern="#,##0.00"/>), que no se cuentan en los ingresos. El Excel incluye el detalle completo de cada venta y pedido (hasta 5000 filas).</p>
<script src="${pageContext.request.contextPath}/assets/echarts/echarts.min.js"></script>
<script src="${pageContext.request.contextPath}/assets/reportes.js"></script>
</c:if>
<%@include file="pie.jspf"%>
