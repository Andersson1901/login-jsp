<%-- Autor: Rodriguez Alvarado Andersson Eduardo --%>
<%@page pageEncoding="UTF-8"%>
<%@include file="cabecera.jspf"%><%@include file="ventas_nav.jspf"%>
<h1><c:out value="${esVenta ? registro.nroVenta : registro.nroSolped}"/></h1><p><strong><c:out value="${registro.cliente}"/></strong> · <c:out value="${registro.fecha}"/> · <span class="estado"><c:out value="${registro.estado}"/></span></p>
<c:if test="${not esVenta}"><p><c:out value="${registro.observacion}"/></p></c:if>
<div class="card table-responsive"><table class="table"><thead><tr><th>Producto</th><th>Cantidad</th><th>Precio sin IGV</th><th>Subtotal</th></tr></thead><tbody><c:forEach var="d" items="${registro.detalles}"><tr><td><c:out value="${d.nombreProducto}"/></td><td><c:out value="${d.cantidad}"/></td><td>S/ <c:out value="${d.precioUnitario}"/></td><td>S/ <c:out value="${d.subtotal}"/></td></tr></c:forEach></tbody></table></div>
<c:choose><c:when test="${esVenta}"><div class="card mt-3"><div class="card-body"><p>Subtotal: S/ <c:out value="${registro.subtotal}"/></p><p>IGV 18%: S/ <c:out value="${registro.igv}"/></p><p class="detalle-total">Total: S/ <c:out value="${registro.total}"/></p></div></div>
<div class="row mt-3 g-3"><div class="col-md-6"><div class="card h-100"><div class="card-body"><h2 class="h5">Comprobante</h2><c:choose><c:when test="${not empty comprobante}"><p><c:out value="${comprobante.tipo}"/> <c:out value="${comprobante.serie}"/>-<fmt:formatNumber value="${comprobante.numero}" pattern="00000000"/></p><p>Emitido: <c:out value="${comprobante.fechaEmision}"/> · S/ <c:out value="${comprobante.total}"/></p><a href="comprobantes">Ver comprobantes</a></c:when><c:otherwise><c:if test="${registro.estado == 'EMITIDA'}"><a class="btn btn-dorado" href="comprobantes?accion=nuevo&amp;idVenta=${registro.idVenta}">Emitir factura o boleta</a></c:if></c:otherwise></c:choose></div></div></div>
<div class="col-md-6"><div class="card h-100"><div class="card-body"><h2 class="h5">Guía de remisión</h2><c:choose><c:when test="${not empty guia}"><p><c:out value="${guia.serie}"/>-<fmt:formatNumber value="${guia.numero}" pattern="00000000"/> · <c:out value="${guia.estado}"/></p><p><c:out value="${guia.puntoPartida}"/> → <c:out value="${guia.puntoLlegada}"/></p><a href="guias">Ver guías</a></c:when><c:otherwise><c:if test="${registro.estado == 'EMITIDA' && not empty comprobante}"><a class="btn btn-dorado" href="guias?accion=nuevo&amp;idVenta=${registro.idVenta}">Generar guía</a></c:if></c:otherwise></c:choose></div></div></div></div>
<p class="text-muted mt-3">Documentos de práctica académica, sin validez tributaria. Si la venta está ANULADA, su comprobante no representa una venta vigente.</p>
</c:when><c:otherwise><p class="detalle-total mt-3">Subtotal sin IGV: S/ <c:out value="${registro.total}"/></p><c:if test="${registro.estado == 'APROBADA'}"><form method="post" action="ventas" data-confirmar="¿Confirmar esta operación?"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${registro.idSolped}"><input type="hidden" name="accion" value="convertir"><button class="btn btn-sm btn-outline-primary">Convertir en venta</button></form></c:if></c:otherwise></c:choose><a class="btn btn-outline-secondary mt-3" href="${pageContext.request.contextPath}${ruta}">Volver</a><%@include file="pie.jspf"%>
