<%@page pageEncoding="UTF-8"%>
<%@include file="cabecera.jspf"%><h1 class="mb-4">Usuario</h1><div class="card"><div class="card-body p-4"><form method="post" action="usuarios"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="accion" value="guardar"><input type="hidden" name="id" value="${registro.idUsuario == 0 ? '' : registro.idUsuario}"><div class="row g-3"><div class="col-md-6"><label class="form-label" for="nombres">Nombres</label><input class="form-control" id="nombres" name="nombres" type="text" maxlength="100" required value="<c:out value='${registro.nombres}'/>"></div>
<div class="col-md-6"><label class="form-label" for="apellidos">Apellidos</label><input class="form-control" id="apellidos" name="apellidos" type="text" maxlength="100" required value="<c:out value='${registro.apellidos}'/>"></div>
<div class="col-md-6"><label class="form-label" for="dni">DNI</label><input class="form-control" id="dni" name="dni" type="text" maxlength="8" required value="<c:out value='${registro.dni}'/>"></div>
<div class="col-md-6"><label class="form-label" for="correo">Correo</label><input class="form-control" id="correo" name="correo" type="email" maxlength="150" required value="<c:out value='${registro.correo}'/>"></div>
<div class="col-md-6"><label class="form-label" for="usuario">Usuario</label><input class="form-control" id="usuario" name="usuario" type="text" maxlength="50" required value="<c:out value='${registro.usuario}'/>"></div>
<div class="col-md-6"><label class="form-label" for="nombreNegocio">Nombre de tienda (para DUEÑO)</label><input class="form-control" id="nombreNegocio" name="nombreNegocio" maxlength="150" value="<c:out value='${registro.nombreNegocio}'/>"></div>
<div class="col-md-6"><label class="form-label" for="rol">Rol</label><select class="form-select" id="rol" name="rol"><option value="ADMIN" ${registro.rol == 'ADMIN' ? 'selected' : ''}>ADMIN</option><option value="DUENO" ${registro.rol == 'DUENO' ? 'selected' : ''}>DUEÑO</option><option value="CLIENTE" ${registro.rol == 'CLIENTE' ? 'selected' : ''}>CLIENTE</option><option value="VENDEDOR" ${registro.rol == 'VENDEDOR' ? 'selected' : ''}>VENDEDOR</option></select></div><div class="col-md-6"><label class="form-label" for="estado">Estado</label><select class="form-select" id="estado" name="estado"><option value="ACTIVO" ${registro.estado == 'ACTIVO' ? 'selected' : ''}>ACTIVO</option><option value="BLOQUEADO" ${registro.estado == 'BLOQUEADO' ? 'selected' : ''}>BLOQUEADO</option><option value="INACTIVO" ${registro.estado == 'INACTIVO' ? 'selected' : ''}>INACTIVO</option></select></div><c:if test="${registro.idUsuario == 0}"><div class="col-md-6"><label class="form-label" for="clave">Clave inicial</label><input class="form-control" type="password" id="clave" name="clave" required minlength="4" maxlength="128" autocomplete="new-password"></div></c:if></div><div class="mt-4"><button class="btn btn-primary">Guardar</button> <a class="btn btn-outline-secondary" href="usuarios">Cancelar</a></div></form></div></div><%@include file="pie.jspf"%>
