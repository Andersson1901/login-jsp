<%@page pageEncoding="UTF-8"%>
<%@include file="cabecera.jspf"%><h1 class="mb-4">Producto</h1><div class="card"><div class="card-body p-4"><form method="post" action="productos"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="accion" value="guardar"><input type="hidden" name="id" value="${registro.idProducto == 0 ? '' : registro.idProducto}"><div class="row g-3">
<div class="col-md-6"><label class="form-label" for="codigo">Código</label><input class="form-control" type="text" id="codigo" name="codigo" maxlength="30" required value="<c:out value='${registro.codigo}'/>"></div>
<div class="col-md-6"><label class="form-label" for="nombre">Nombre</label><input class="form-control" type="text" id="nombre" name="nombre" maxlength="150" required value="<c:out value='${registro.nombre}'/>"></div>
<div class="col-md-6"><label class="form-label" for="descripcion">Descripción</label><input class="form-control" type="text" id="descripcion" name="descripcion" maxlength="500" required value="<c:out value='${registro.descripcion}'/>"></div>
<div class="col-md-6"><label class="form-label" for="tipo">Tipo</label><select class="form-select" name="tipo" id="tipo"><option value="MERCADERIA" ${registro.tipo == 'MERCADERIA' ? 'selected' : ''}>MERCADERIA</option><option value="PRODUCTO" ${registro.tipo == 'PRODUCTO' ? 'selected' : ''}>PRODUCTO</option><option value="INSUMO" ${registro.tipo == 'INSUMO' ? 'selected' : ''}>INSUMO</option><option value="SERVICIO" ${registro.tipo == 'SERVICIO' ? 'selected' : ''}>SERVICIO</option></select></div>
<div class="col-md-6"><label class="form-label" for="categoria">Categoría</label><input class="form-control" type="text" id="categoria" name="categoria" maxlength="80" required value="<c:out value='${registro.categoria}'/>"></div>
<div class="col-md-6"><label class="form-label" for="unidadMedida">Unidad de medida</label><input class="form-control" type="text" id="unidadMedida" name="unidadMedida" maxlength="20" required value="<c:out value='${registro.unidadMedida}'/>"></div>
<div class="col-md-6"><label class="form-label" for="precioCompra">Precio de compra (S/)</label><input class="form-control" type="number" min="0" max="99999999" step="0.01" id="precioCompra" name="precioCompra" required value="<c:out value='${empty registro.precioCompra ? 0 : registro.precioCompra}'/>"></div>
<div class="col-md-6"><label class="form-label" for="precioVenta">Precio sin IGV (S/)</label><input class="form-control" type="number" min="0" max="99999999" step="0.01" id="precioVenta" name="precioVenta" required value="<c:out value='${empty registro.precioVenta ? 0 : registro.precioVenta}'/>"></div>
<div class="col-md-6"><label class="form-label" for="stock">Stock</label><input class="form-control" type="number" min="0" max="99999999" step="0.001" id="stock" name="stock" required value="<c:out value='${empty registro.stock ? 0 : registro.stock}'/>"></div>
<div class="col-md-6"><label class="form-label" for="stockMinimo">Stock mínimo</label><input class="form-control" type="number" min="0" max="99999999" step="0.001" id="stockMinimo" name="stockMinimo" required value="<c:out value='${empty registro.stockMinimo ? 0 : registro.stockMinimo}'/>"></div>
<div class="col-md-6"><label class="form-label" for="estado">Estado</label><select class="form-select" name="estado" id="estado"><option value="ACTIVO" ${registro.estado == 'ACTIVO' ? 'selected' : ''}>ACTIVO</option><option value="INACTIVO" ${registro.estado == 'INACTIVO' ? 'selected' : ''}>INACTIVO</option></select></div>
<p class="text-muted">Los servicios siempre tienen stock y stock mínimo cero. Los precios de venta no incluyen IGV.</p></div><div class="mt-4"><button class="btn btn-primary">Guardar</button> <a class="btn btn-outline-secondary" href="productos">Cancelar</a></div></form></div></div><%@include file="pie.jspf"%>
