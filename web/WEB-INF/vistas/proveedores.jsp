<%@page pageEncoding="UTF-8"%>
<%@include file="cabecera.jspf"%><div class="d-flex justify-content-between align-items-center mb-3"><h1>Proveedores</h1><a class="btn btn-dorado" href="proveedores?accion=nuevo">Nuevo proveedor</a></div>
<form method="get" action="proveedores" class="d-flex gap-2 mb-3"><input class="form-control" name="q" maxlength="100" aria-label="Buscar" placeholder="Buscar, o escribe Columna: valor" value="<c:out value='${q}'/>" data-buscar><input type="hidden" name="orden" value="<c:out value='${param.orden}'/>"><input type="hidden" name="dir" value="<c:out value='${param.dir}'/>"><input type="hidden" name="limite" value="<c:out value='${param.limite}'/>"><button class="btn btn-primary">Buscar</button></form>
<div id="resultados"><t:limite base="proveedores"/><div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><t:ordenable base="proveedores" columna="ruc" titulo="RUC"/><t:ordenable base="proveedores" columna="razon" titulo="Razón social"/><t:ordenable base="proveedores" columna="contacto" titulo="Contacto"/><t:ordenable base="proveedores" columna="telefono" titulo="Teléfono"/><t:ordenable base="proveedores" columna="estado" titulo="Estado"/><th>Acciones</th></tr></thead><tbody><c:forEach var="r" items="${registros}"><tr><td><c:out value="${r.ruc}"/></td><td><c:out value="${r.razonSocial}"/></td><td><c:out value="${r.contacto}"/></td><td><c:out value="${r.telefono}"/></td><td><c:out value="${r.estado}"/></td><td><div class="acciones"><a class="btn btn-sm btn-outline-primary" href="proveedores?accion=editar&amp;id=${r.idProveedor}">Editar</a><form method="post" action="proveedores" data-confirmar="¿Eliminar este registro? Esta acción no se puede deshacer."><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${r.idProveedor}"><button class="btn btn-sm btn-outline-danger" name="accion" value="eliminar">Eliminar</button></form></div></td></tr></c:forEach>
<c:if test="${empty registros}"><tr><td colspan="6" class="tabla-vacia">No hay registros para mostrar.</td></tr></c:if></tbody></table></div></div><t:paginador pagina="${pagina}" base="proveedores"/></div><%@include file="pie.jspf"%>
