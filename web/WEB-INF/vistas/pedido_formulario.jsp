<%@page pageEncoding="UTF-8"%>
<%@include file="cabecera.jspf"%><%@include file="ventas_nav.jspf"%>
<h1 class="mb-3"><c:choose><c:when test="${esVenta}">Editar venta</c:when><c:otherwise>Solicitud de pedido</c:otherwise></c:choose></h1>
<p class="text-muted">Los precios se toman del catálogo al guardar. El pedido no reserva existencias.</p>
<form method="post" action="${pageContext.request.contextPath}${ruta}" id="pedidoFormulario"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="accion" value="guardar">
<c:choose><c:when test="${esVenta}"><input type="hidden" name="id" value="${registro.idVenta}"><p>Cliente: <c:out value="${registro.cliente}"/></p></c:when><c:otherwise>
<input type="hidden" name="id" value="${registro.idSolped == 0 ? '' : registro.idSolped}"><div class="card mb-3"><div class="card-body"><label class="form-label" for="idCliente">Cliente</label><select class="form-select mb-3" id="idCliente" name="idCliente" required><option value="">Selecciona un cliente activo</option><c:forEach var="c" items="${clientes}"><c:if test="${c.estado == 'ACTIVO'}"><option value="${c.idCliente}" ${registro.idCliente == c.idCliente ? 'selected' : ''}><c:out value="${c.nroDocumento}"/> · <c:out value="${c.nombresRazonSocial}"/></option></c:if></c:forEach></select>
<label class="form-label" for="observacion">Observación</label><textarea class="form-control" id="observacion" name="observacion" maxlength="500"><c:out value="${registro.observacion}"/></textarea></div></div></c:otherwise></c:choose>
<div class="card"><div class="card-body"><div class="table-responsive"><table class="table"><thead><tr><th>Producto / servicio</th><th>Cantidad</th><th>Precio sin IGV</th><th>Importe</th><th></th></tr></thead><tbody id="itemsPedido">
<c:forEach var="d" items="${registro.detalles}"><tr><td><select class="form-select producto" name="idProducto" required><option value="">Selecciona</option><c:forEach var="p" items="${productos}"><c:if test="${p.estado == 'ACTIVO' || p.idProducto == d.idProducto}"><option value="${p.idProducto}" data-precio="${p.precioVenta}" ${p.idProducto == d.idProducto ? 'selected' : ''}><c:out value="${p.codigo}"/> · <c:out value="${p.nombre}"/></option></c:if></c:forEach></select></td><td><input class="form-control cantidad" type="number" name="cantidad" min="0.001" max="999999" step="0.001" value="${d.cantidad}" required></td><td class="precio"></td><td class="importe"></td><td><button type="button" class="btn btn-outline-danger quitar">Quitar</button></td></tr></c:forEach>
</tbody></table></div><button type="button" id="agregarItem" class="btn btn-outline-primary">Agregar ítem</button><p class="mt-3">Subtotal estimado: S/ <strong id="subtotalPedido">0.00</strong></p><p>IGV 18%: S/ <span id="igvPedido">0.00</span> · Total: S/ <strong id="totalPedido">0.00</strong></p></div></div>
<div class="mt-4"><button class="btn btn-primary">Guardar</button> <a class="btn btn-outline-secondary" href="${pageContext.request.contextPath}${ruta}">Cancelar</a></div></form>
<template id="plantillaItem"><tr><td><select class="form-select producto" name="idProducto" required><option value="">Selecciona</option><c:forEach var="p" items="${productos}"><c:if test="${p.estado == 'ACTIVO'}"><option value="${p.idProducto}" data-precio="${p.precioVenta}"><c:out value="${p.codigo}"/> · <c:out value="${p.nombre}"/></option></c:if></c:forEach></select></td><td><input class="form-control cantidad" type="number" name="cantidad" min="0.001" max="999999" step="0.001" value="1" required></td><td class="precio"></td><td class="importe"></td><td><button type="button" class="btn btn-outline-danger quitar">Quitar</button></td></tr></template>
<script src="${pageContext.request.contextPath}/assets/pedidos.js"></script>
<%@include file="pie.jspf"%>
