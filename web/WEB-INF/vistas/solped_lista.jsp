<%@page pageEncoding="UTF-8"%>
<%@include file="cabecera.jspf"%><%@include file="ventas_nav.jspf"%>
<div class="d-flex justify-content-between mb-3"><h1>Solicitudes de pedido</h1><a class="btn btn-dorado" href="solped?accion=nuevo">Nueva SOLPED</a></div><p class="text-muted">Prepara el pedido y apruébalo antes de convertirlo en venta.</p><div class="card table-responsive"><table class="table align-middle"><thead><tr><th>Número</th><th>Cliente</th><th>Fecha</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><c:forEach var="r" items="${registros}"><tr><td><a href="solped?accion=ver&amp;id=${r.idSolped}"><c:out value="${r.nroSolped}"/></a></td><td><c:out value="${r.cliente}"/></td><td><c:out value="${r.fecha}"/></td><td><c:out value="${r.estado}"/></td><td><div class="acciones"><c:if test="${r.estado == 'PENDIENTE'}"><a class="btn btn-sm btn-outline-primary" href="solped?accion=editar&amp;id=${r.idSolped}">Editar</a><form method="post" action="solped"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${r.idSolped}"><input type="hidden" name="accion" value="estado"><input type="hidden" name="estado" value="APROBADA"><button class="btn btn-sm btn-outline-primary">Aprobar</button></form></c:if><c:if test="${r.estado == 'APROBADA'}"><form method="post" action="ventas" data-confirmar="¿Confirmar esta operación?"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${r.idSolped}"><input type="hidden" name="accion" value="convertir"><button class="btn btn-sm btn-outline-primary">Convertir en venta</button></form><form method="post" action="solped"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${r.idSolped}"><input type="hidden" name="accion" value="estado"><input type="hidden" name="estado" value="PENDIENTE"><button class="btn btn-sm btn-outline-primary">Volver a pendiente</button></form></c:if><c:if test="${r.estado == 'PENDIENTE' || r.estado == 'APROBADA'}"><form method="post" action="solped" data-confirmar="¿Confirmar esta operación?"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${r.idSolped}"><input type="hidden" name="accion" value="estado"><input type="hidden" name="estado" value="ANULADA"><button class="btn btn-sm btn-outline-primary">Anular</button></form></c:if><c:if test="${r.estado == 'PENDIENTE' || r.estado == 'ANULADA'}"><form method="post" action="solped" data-confirmar="¿Confirmar esta operación?"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${r.idSolped}"><input type="hidden" name="accion" value="eliminar"><button class="btn btn-sm btn-outline-primary">Eliminar</button></form></c:if></div></td></tr></c:forEach><c:if test="${empty registros}"><tr><td colspan="5" class="tabla-vacia">Aún no hay solicitudes.</td></tr></c:if></tbody></table></div><%@include file="pie.jspf"%>
