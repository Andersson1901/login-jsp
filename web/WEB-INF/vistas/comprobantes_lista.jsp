<%@page pageEncoding="UTF-8"%>
<%@include file="cabecera.jspf"%><%@include file="ventas_nav.jspf"%>
<div class="d-flex justify-content-between mb-3"><h1>Comprobantes</h1><a class="btn btn-dorado" href="comprobantes?accion=nuevo">Nuevo documento</a></div><div class="alert alert-light border">Documentos de práctica académica, sin validez tributaria.</div><div class="card table-responsive"><table class="table align-middle"><thead><tr><th>Serie / Número</th><th>Tipo</th><th>Venta</th><th>Fecha de emisión</th><th>Total S/</th><th>Acciones</th></tr></thead><tbody><c:forEach var="r" items="${registros}"><tr><td><c:out value="${r.serie}"/>-<fmt:formatNumber value="${r.numero}" pattern="00000000"/></td><td><c:out value="${r.tipo}"/></td><td><c:out value="${r.nroVenta}"/></td><td><c:out value="${r.fechaEmision}"/></td><td><c:out value="${r.total}"/></td><td><div class="acciones"><a class="btn btn-sm btn-outline-primary" href="comprobantes?accion=editar&amp;id=${r.idComprobante}">Editar</a><a class="btn btn-sm btn-outline-secondary" href="ventas?accion=ver&amp;id=${r.idVenta}">Ver venta</a><form method="post" action="comprobantes" data-confirmar="¿Confirmar esta operación?"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${r.idComprobante}"><input type="hidden" name="accion" value="eliminar"><button class="btn btn-sm btn-outline-primary">Eliminar</button></form></div></td></tr></c:forEach><c:if test="${empty registros}"><tr><td colspan="6" class="tabla-vacia">Aún no hay documentos.</td></tr></c:if></tbody></table></div><%@include file="pie.jspf"%>
