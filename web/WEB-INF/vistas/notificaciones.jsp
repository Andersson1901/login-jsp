<%@page pageEncoding="UTF-8"%>
<%@include file="cabecera.jspf"%>
<div class="d-flex justify-content-between mb-3"><h1>Notificaciones de ventas</h1><form method="post" action="notificaciones"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="accion" value="leer"><button class="btn btn-dorado">Marcar todas como leídas</button></form></div><div class="card table-responsive"><table class="table align-middle"><thead><tr><th>Fecha</th><th>Venta</th><th>Cliente</th><th>Total</th><th>Cambio de estado</th><th>Acciones</th></tr></thead><tbody><c:forEach var="r" items="${registros}"><tr><td><fmt:formatDate value="${r.fecha}" pattern="dd/MM/yyyy HH:mm"/></td><td><c:out value="${r.nroVenta}"/></td><td><c:out value="${r.cliente}"/></td><td>S/ <c:out value="${r.total}"/></td><td><c:choose><c:when test="${empty r.estadoAnterior}">Venta emitida</c:when><c:otherwise><c:out value="${r.estadoAnterior}"/> → <c:out value="${r.estadoNuevo}"/></c:otherwise></c:choose><c:if test="${not r.leida}"> <span class="estado">Nueva</span></c:if></td><td><c:if test="${r.idVenta > 0}"><a class="btn btn-sm btn-outline-secondary" href="ventas?accion=ver&amp;id=${r.idVenta}">Ver venta</a></c:if></td></tr></c:forEach><c:if test="${empty registros}"><tr><td colspan="6" class="tabla-vacia">Aún no hay notificaciones.</td></tr></c:if></tbody></table></div><p class="text-muted mt-3">Recibes un aviso cuando una venta se emite o se anula. Se muestran los últimos 100.</p><%@include file="pie.jspf"%>
