<%-- Autor: Rodriguez Alvarado Andersson Eduardo --%>
<%@page pageEncoding="UTF-8"%>
<%@include file="publica_cabecera.jspf"%>
<div class="formulario-publico mx-auto">
<p class="etiqueta-publica">ÚNETE A MODAEXPRESS</p>
<h1 class="h2"><c:out value="${tituloRegistro}"/></h1>
<p class="text-muted"><c:out value="${descripcionRegistro}"/> Tu cuenta quedará activa al registrarte.</p>
<div class="card border-0 shadow-sm"><div class="card-body p-4">
<c:if test="${not empty error}"><div class="alert alert-danger" role="alert"><c:out value="${error}"/></div></c:if>
<form method="post" action="${pageContext.request.contextPath}/registro">
<input type="hidden" name="csrfPublico" value="<c:out value='${csrfPublico}'/>">
<input type="hidden" name="tipo" value="<c:out value='${tipoRegistro}'/>">
<div class="row g-3">
<div class="col-md-6"><label for="nombres" class="form-label">Nombres</label>
<input class="form-control" id="nombres" name="nombres" type="text" maxlength="100" autocomplete="given-name" required value="<c:out value='${registro.nombres}'/>"></div>
<div class="col-md-6"><label for="apellidos" class="form-label">Apellidos</label>
<input class="form-control" id="apellidos" name="apellidos" type="text" maxlength="100" autocomplete="family-name" required value="<c:out value='${registro.apellidos}'/>"></div>
<div class="col-md-6"><label for="dni" class="form-label">DNI</label>
<input class="form-control" id="dni" name="dni" type="text" maxlength="8" autocomplete="off" required pattern="[0-9]{8}" inputmode="numeric" value="<c:out value='${registro.dni}'/>"></div>
<div class="col-md-6"><label for="correo" class="form-label">Correo electrónico</label>
<input class="form-control" id="correo" name="correo" type="email" maxlength="150" autocomplete="email" required value="<c:out value='${registro.correo}'/>"></div>
<div class="col-md-6"><label for="usuario" class="form-label">Usuario</label>
<input class="form-control" id="usuario" name="usuario" type="text" maxlength="50" autocomplete="username" required value="<c:out value='${registro.usuario}'/>"></div>
<div class="col-md-6"><label for="clave" class="form-label">Contraseña</label>
<input class="form-control" id="clave" name="clave" type="password" minlength="4" maxlength="128" autocomplete="new-password" required>
<small class="text-muted">Entre 4 y 128 caracteres.</small></div>
<c:if test="${tipoRegistro == 'TIENDA'}"><div class="col-12"><label for="nombreNegocio" class="form-label">Nombre de tu tienda</label>
<input class="form-control" id="nombreNegocio" name="nombreNegocio" maxlength="150" required value="<c:out value='${registro.nombreNegocio}'/>"></div></c:if>
</div>
<button class="btn btn-dorado w-100 mt-4" type="submit">Crear cuenta</button>
</form>
<p class="mt-3 mb-0 text-center">¿Ya tienes una cuenta? <a href="${pageContext.request.contextPath}/login.jsp">Inicia sesión</a></p>
</div></div></div>
<%@include file="publica_pie.jspf"%>
