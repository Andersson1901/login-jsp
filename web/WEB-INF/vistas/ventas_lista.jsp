<%@page pageEncoding="UTF-8"%>
<%@include file="cabecera.jspf"%><%@include file="ventas_nav.jspf"%>
<div class="d-flex justify-content-between mb-3"><h1>Ventas</h1><a class="btn btn-dorado" href="solped">Convertir una SOLPED aprobada</a></div><div class="card table-responsive"><table class="table align-middle"><thead><tr><th>Venta / SOLPED</th><th>Cliente</th><th>Subtotal</th><th>IGV 18%</th><th>Total</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><c:forEach var="r" items="${registros}"><tr><td><a href="ventas?accion=ver&amp;id=${r.idVenta}"><c:out value="${r.nroVenta}"/></a><br><small><c:out value="${r.nroSolped}"/></small></td><td><c:out value="${r.cliente}"/></td><td>S/ <c:out value="${r.subtotal}"/></td><td>S/ <c:out value="${r.igv}"/></td><td>S/ <c:out value="${r.total}"/></td><td><c:out value="${r.estado}"/></td><td><div class="acciones"><a class="btn btn-sm btn-outline-primary" href="ventas?accion=ver&amp;id=${r.idVenta}">Ver</a><c:if test="${r.estado == 'EMITIDA'}"><a class="btn btn-sm btn-outline-primary" href="ventas?accion=editar&amp;id=${r.idVenta}">Editar</a><form method="post" action="ventas" data-confirmar="¿Confirmar esta operación?"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${r.idVenta}"><input type="hidden" name="accion" value="anular"><button class="btn btn-sm btn-outline-primary">Anular y devolver stock</button></form></c:if><c:if test="${r.estado == 'ANULADA'}"><form method="post" action="ventas" data-confirmar="¿Confirmar esta operación?"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${r.idVenta}"><input type="hidden" name="accion" value="eliminar"><button class="btn btn-sm btn-outline-primary">Eliminar</button></form></c:if></div></td></tr></c:forEach><c:if test="${empty registros}"><tr><td colspan="7" class="tabla-vacia">Aún no hay ventas.</td></tr></c:if></tbody></table></div><p class="text-muted mt-3">La edición solo se permite antes de emitir documentos. La anulación devuelve el stock una sola vez. Para eliminar una venta anulada, elimina primero su guía y comprobante.</p><%@include file="pie.jspf"%>
