<%@page pageEncoding="UTF-8"%>
<%@include file="cabecera.jspf"%><h1 class="mb-4">Cliente</h1><div class="card"><div class="card-body p-4"><form method="post" action="clientes"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="accion" value="guardar"><input type="hidden" name="id" value="${registro.idCliente == 0 ? '' : registro.idCliente}"><div class="row g-3">
<div class="col-md-6"><label class="form-label" for="tipoDocumento">Tipo de documento</label><select class="form-select" name="tipoDocumento" id="tipoDocumento"><option value="DNI" ${registro.tipoDocumento == 'DNI' ? 'selected' : ''}>DNI</option><option value="RUC" ${registro.tipoDocumento == 'RUC' ? 'selected' : ''}>RUC</option></select></div>
<div class="col-md-6"><label class="form-label" for="nroDocumento">Número de documento</label><input class="form-control" type="text" id="nroDocumento" name="nroDocumento" maxlength="11" required value="<c:out value='${registro.nroDocumento}'/>"></div>
<div class="col-md-6"><label class="form-label" for="nombresRazonSocial">Nombres / Razón social</label><input class="form-control" type="text" id="nombresRazonSocial" name="nombresRazonSocial" maxlength="150" required value="<c:out value='${registro.nombresRazonSocial}'/>"></div>
<div class="col-md-6"><label class="form-label" for="direccion">Dirección</label><input class="form-control" type="text" id="direccion" name="direccion" maxlength="200" required value="<c:out value='${registro.direccion}'/>"></div>
<div class="col-md-6"><label class="form-label" for="telefono">Teléfono</label><input class="form-control" type="text" id="telefono" name="telefono" maxlength="20" required value="<c:out value='${registro.telefono}'/>"></div>
<div class="col-md-6"><label class="form-label" for="correo">Correo</label><input class="form-control" type="email" id="correo" name="correo" maxlength="150" required value="<c:out value='${registro.correo}'/>"></div>
<div class="col-md-6"><label class="form-label" for="estado">Estado</label><select class="form-select" name="estado" id="estado"><option value="ACTIVO" ${registro.estado == 'ACTIVO' ? 'selected' : ''}>ACTIVO</option><option value="INACTIVO" ${registro.estado == 'INACTIVO' ? 'selected' : ''}>INACTIVO</option></select></div>
</div><div class="mt-4"><button class="btn btn-primary">Guardar</button> <a class="btn btn-outline-secondary" href="clientes">Cancelar</a></div></form></div></div><%@include file="pie.jspf"%>
