<%@include file="cabecera.jspf"%><div class="d-flex justify-content-between align-items-center mb-3"><h1>Productos</h1><a class="btn btn-dorado" href="productos?accion=nuevo">Nuevo producto</a></div>
<form method="get" action="productos" class="d-flex gap-2 mb-3"><input class="form-control" name="q" maxlength="100" aria-label="Buscar" placeholder="Buscar por nombre o identificador" value="<c:out value='${q}'/>"><button class="btn btn-primary">Buscar</button></form>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Código</th><th>Nombre</th><th>Tipo</th><th>Categoría</th><th>Precio sin IGV (S/)</th><th>Stock</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><c:forEach var="r" items="${registros}"><tr><td><c:out value="${r.codigo}"/></td><td><c:out value="${r.nombre}"/></td><td><c:out value="${r.tipo}"/></td><td><c:out value="${r.categoria}"/></td><td><c:out value="${r.precioVenta}"/></td><td><c:out value="${r.stock}"/></td><td><c:out value="${r.estado}"/></td><td><div class="acciones"><a class="btn btn-sm btn-outline-primary" href="productos?accion=editar&amp;id=${r.idProducto}">Editar</a><form method="post" action="productos" data-confirmar="¿Eliminar este registro? Esta acción no se puede deshacer."><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="id" value="${r.idProducto}"><button class="btn btn-sm btn-outline-danger" name="accion" value="eliminar">Eliminar</button></form></div></td></tr></c:forEach>
<c:if test="${empty registros}"><tr><td colspan="8" class="tabla-vacia">No hay registros para mostrar.</td></tr></c:if></tbody></table></div></div><%@include file="pie.jspf"%>
